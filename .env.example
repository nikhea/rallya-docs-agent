# PostgreSQL (pgvector extension required) — storage + Knowledge vectors
# Local development: plain Postgres (docker), as below.
# Production: set DATABASE_URL to the *pooled* Neon connection string
# (project mute-sky-16638432, branch production) — e.g. via `neon env pull`.
# Do not commit Neon credentials here.
DATABASE_URL=postgresql://admin:adminpassword@localhost:5432/rallya_docs_agent

# Sanity (same values as rallya-docs/sanity/lib/client.ts)
SANITY_PROJECT_ID=ejoyp5f4
SANITY_DATASET=production
# Required: the dataset is private
SANITY_API_READ_TOKEN=
# Docs website: each Knowledge page ends with "Source: <url>/<slug>"
DOCS_BASE_URL=https://rallya-docs.vercel.app/docs

# Knowledge scope holding the docs tree, e.g. docs:rallya#getting-started
KNOWLEDGE_SCOPE=docs:rallya

# Embeddings over an OpenAI-compatible endpoint (defaults to local Ollama)
EMBEDDER_PROVIDER_ID=ollama
EMBEDDER_MODEL_ID=hf.co/unsloth/embeddinggemma-2-GGUF:Q8_0
EMBEDDER_URL=http://localhost:11434/v1
EMBEDDER_API_KEY=not-needed

# Chat model for the agent (any provider/model on the Mastra model router)
DOCS_AGENT_MODEL=ollama-cloud/gpt-oss:120b
# Groq works too: DOCS_AGENT_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=

# Public docs chat endpoint (POST /docs-chat) — unauthenticated by design.
# Comma-separated CORS origins; defaults to '*' because no cookies are set.
# Restrict browser callers with e.g.:
# DOCS_CHAT_CORS_ORIGINS=https://rallya-docs.vercel.app

# Optional tuning
# API tokens for the server (SimpleAuth, see src/mastra/auth.ts). When at
# least one is set, /api/* and /knowledge/* require a token. Unset means the
# server starts UNAUTHENTICATED (dev convenience) — do not do this in public.
# DOCS_AGENT_ADMIN_TOKEN=sk-admin-...
# DOCS_AGENT_USER_TOKEN=sk-user-...

# Optional tuning
# KNOWLEDGE_READ_MAX_TOKENS=2000
# KNOWLEDGE_PINNED_MAX_TOKENS=700
# Message history token budget (prompt + history + current turn)
# MEMORY_MAX_TOKENS=32000
# MEMORY_AT_MAX_REMOVE_TOKENS=8000

# Observability (traces, logs, metrics) is stored in DuckDB — local dev only
# DUCKDB_PATH=/absolute/path/to/mastra.duckdb   (default: project root)
# console log level: debug | info | warn | error
# LOG_LEVEL=info
# pretty text logs (default: on unless NODE_ENV=production)
# LOG_PRETTY=true
# TRACE_INCLUDE_INTERNAL_SPANS=true
