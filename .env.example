# PostgreSQL (pgvector extension required) — storage + Knowledge vectors
# Local development: plain Postgres (docker), as below.
# Production: set DATABASE_URL to the *pooled* Neon connection string
# (project mute-sky-16638432, branch production) — e.g. via `neon env pull`.
# Do not commit Neon credentials here.
DATABASE_URL=postgresql://admin:adminpassword@localhost:5432/rallya_docs_agent

# Sanity (same values as rallya-docs/sanity/lib/client.ts)
SANITY_PROJECT_ID=ejoyp5f4
SANITY_DATASET=production
# Required: the dataset is private
SANITY_API_READ_TOKEN=
# Docs website: each Knowledge page ends with "Source: <url>/<slug>"
DOCS_BASE_URL=https://rallya-docs.vercel.app/docs

# Knowledge scope holding the docs tree, e.g. docs:rallya#getting-started
KNOWLEDGE_SCOPE=docs:rallya

# Embeddings over an OpenAI-compatible endpoint (defaults to local Ollama)
EMBEDDER_PROVIDER_ID=ollama
EMBEDDER_MODEL_ID=hf.co/unsloth/embeddinggemma-2-GGUF:Q8_0
EMBEDDER_URL=http://localhost:11434/v1
EMBEDDER_API_KEY=not-needed

# Chat model for the agent (any provider/model on the Mastra model router)
DOCS_AGENT_MODEL=ollama-cloud/gpt-oss:120b
# Groq works too: DOCS_AGENT_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=

# Public docs chat endpoint (POST /docs-chat) — unauthenticated by design.
# Comma-separated CORS origins; defaults to '*' because no cookies are set.
# Restrict browser callers with e.g.:
# DOCS_CHAT_CORS_ORIGINS=https://rallya-docs.vercel.app

# Redis-backed rate limiting for the public routes (/docs-chat, /docs-feedback).
# Without REDIS_URL the limiter is disabled with a warning (dev convenience);
# set it in production so all replicas share one counter. Present-but-invalid
# values fail startup with a clear error (zod validation in src/mastra/config.ts).
# Local development uses a plain Redis on localhost.
# REDIS_URL=redis://localhost:6379
# Production uses the Upstash TCP endpoint (TLS). Set REDIS_URL in the Mastra
# Platform env record, not in .env.production:
# REDIS_URL=rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<endpoint>:6379
# RATE_LIMIT_ENABLED=true
#
# The limiter uses ioredis over the TCP URL above. The Upstash REST client in
# src/mastra/lib/redis.ts is kept separately for non-limiter use; never commit
# real values.
# UPSTASH_REDIS_REST_URL=https://<endpoint>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
#
# Limits per client IP (sliding window): 10 chat/min, 15 feedback/min.
# DOCS_CHAT_RATE_LIMIT_MAX=10
# DOCS_CHAT_RATE_LIMIT_WINDOW_MS=60000
# DOCS_FEEDBACK_RATE_LIMIT_MAX=15
# DOCS_FEEDBACK_RATE_LIMIT_WINDOW_MS=60000
#
# Client identity. CLIENT_IP_SOURCE picks the ONE header to trust:
#   x-forwarded-for  — comma-separated chain (default)
#   x-real-ip        — single value; only safe if the edge overwrites it
#   cf-connecting-ip — only meaningful when the edge is Cloudflare
# No cross-check is performed against the other headers or the socket address.
#
# For x-forwarded-for, TRUSTED_PROXY_HOPS=N selects the entry N positions from
# the RIGHT of the chain. N counts the trusted proxies that APPEND their peer to
# X-Forwarded-For between the client and this process; the left side is never
# trusted. With a single edge that overwrites or appends, N=0 is correct — the
# rightmost entry is the address the edge saw. Add one per additional appending
# hop (e.g. CDN -> load balancer -> app) or the limiter will key on a proxy IP.
# Too few hops for the chain can let a spoofed value become the key; too many
# makes every request look IP-less. Confirm with the deployed canary in
# plan/rate-limit-hardening.md before changing the default. IPs are validated,
# IPv4-mapped IPv6 collapses to IPv4, and IPv6 is folded to a /64 prefix (a
# whole /64 shares one bucket).
# CLIENT_IP_SOURCE=x-forwarded-for
# TRUSTED_PROXY_HOPS=0
#
# When no valid IP can be derived: 'deny' fails closed (default,
# X-RateLimit-Limit: 0), 'strict' applies a small shared bucket instead. The
# first event per route and every 100th thereafter emit a structured
# rate_limit_unknown_ip warning (route/policy/count/counter); every event
# increments the per-route counter. Alert on a sustained non-zero rate.
# UNKNOWN_IP_POLICY=deny
# UNKNOWN_IP_STRICT_MAX=3
#
# A slow Redis must not add latency; commands time out after this many ms and
# the limiter drops into a bounded in-memory floor at max * multiplier per
# instance (N replicas therefore allow roughly N * multiplier * max). The
# transition emits one error-level rate_limit_degraded line per route with
# route/reason/counter/error; rate_limit_recovered marks recovery. Alert on
# degraded. X-RateLimit-Reset is EPOCH SECONDS; Retry-After is delta seconds;
# the full header and 429 contract is in README.md ("Rate limits").
# REDIS_COMMAND_TIMEOUT_MS=200
# RATE_LIMIT_FALLBACK_MULTIPLIER=2

# Optional tuning
# API tokens for the server (SimpleAuth, see src/mastra/auth.ts). When at
# least one is set, /api/* and /knowledge/* require a token. Unset means the
# server starts UNAUTHENTICATED (dev convenience) — do not do this in public.
# DOCS_AGENT_ADMIN_TOKEN=sk-admin-...
# DOCS_AGENT_USER_TOKEN=sk-user-...

# Optional tuning
# KNOWLEDGE_READ_MAX_TOKENS=2000
# KNOWLEDGE_PINNED_MAX_TOKENS=700
# Message history token budget (prompt + history + current turn)
# MEMORY_MAX_TOKENS=32000
# MEMORY_AT_MAX_REMOVE_TOKENS=8000

# Observability storage (traces, logs, metrics, scores, feedback).
#   duckdb   - embedded file, the default. Local development only.
#   postgres - ObservabilityStoragePostgresVNext. Required in production: the
#              store must be shared and durable for POST /docs-feedback, which
#              rehydrates the target trace before recording feedback.
# OBSERVABILITY_STORAGE=duckdb
# DuckDB file for `OBSERVABILITY_STORAGE=duckdb` (default: project root).
# DUCKDB_PATH=/absolute/path/to/mastra.duckdb
#
# Postgres settings, used only when OBSERVABILITY_STORAGE=postgres.
# The v-next domain is append-only and write-heavy, so in production point
# OBSERVABILITY_DATABASE_URL at a dedicated database/branch (for Neon, a
# separate database or branch rather than the app database). Defaults to
# DATABASE_URL.
# OBSERVABILITY_DATABASE_URL=postgresql://.../rallya_docs_observability
# OBSERVABILITY_SCHEMA=mastra_observability
# Daily partitions pre-created on init (native partitioning without Timescale /
# pg_partman). Raise this if one instance runs longer without a redeploy.
# OBSERVABILITY_PARTITION_FUTURE_DAYS=30
# console log level: debug | info | warn | error
# LOG_LEVEL=info
# pretty text logs (default: on unless NODE_ENV=production)
# LOG_PRETTY=true
# TRACE_INCLUDE_INTERNAL_SPANS=true
