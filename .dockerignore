# Dependencies
node_modules

# Build output (regenerated by `mastra build`)
.mastra
dist
out

# Local observability / database files — never ship these in an image
*.duckdb
*.duckdb.wal
*.db-*
logs
coverage
*.tgz

# Local tooling / editor state
.opencode
.agents
.idea
.vscode

# Secrets and local env files (runtime env is injected by the platform)
.env
.env.*
!.env.example

# Git and docs not needed at build time
.git
.gitignore
